# Local MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=vpm_clubconnect
MYSQL_USERNAME=clubconnect_app
MYSQL_PASSWORD=change-me

# Email is disabled by default. Configure a provider before enabling it.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@example.com
MAIL_FROM_NAME=ClubConnect
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
